{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "newsfellow",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"ai": {
		"binding": "AI"
	},
	"triggers": {
		"crons": [
			"15 * * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "newsfellow",
			"database_id": "ce6d4811-384f-45bb-9185-052a52e09d00",
			"migrations_dir":"migrations",
			"remote": true
		}
	],
	"vars": {
		"OWNER_TIMEZONE": "America/Chicago",
		"MAX_DIGEST_STORIES": "6",
		"AI_SUMMARIZER_ENABLED": "true",
		"AI_SUMMARY_MODEL": "@cf/meta/llama-3.2-1b-instruct",
		"AI_ENRICHMENT_MODEL": "@cf/meta/llama-3.2-3b-instruct",
		"AI_EMBEDDING_MODEL": "@cf/baai/bge-small-en-v1.5",
		"AI_ENRICHMENT_ENABLED": "true",
		"AI_GATEWAY_CACHE_TTL_SECONDS": "86400",
		"FLA_NEWS_ENABLED": "false",
		"FLA_TIMEZONE": "America/Chicago",
		"FLA_MAX_DIGEST_STORIES": "6"
	}
}
